// Markdown to Word (JMCO house format). RETIRED after first use for ailicence/: Word files are hand-edited masters. Never regenerate over them.
// Converts a simple Markdown file to a Word document in the JMCO house format.
// Usage: node md2docx.js input.md output.docx
const fs=require('fs');
const {Document,Packer,Paragraph,TextRun,Table,TableRow,TableCell,WidthType,ShadingType,BorderStyle,AlignmentType,LevelFormat,Footer,PageNumber,HeadingLevel,ExternalHyperlink}=require('docx');
const BLUE='1F4E79', F='Arial', GREY='7F7F7F';
const [,, inp, out]=process.argv;
const lines=fs.readFileSync(inp,'utf8').replace(/\r/g,'').split('\n');

// inline parser: **bold**, *italic*, `code`, [text](url); [TBC: ...] in backticks -> grey italic
function inline(text, st={}, size=20){
  const runs=[];
  const push=(t,extra={})=>{ if(t) runs.push(new TextRun({text:t,font:F,size,...st,...extra})); };
  let i=0;
  const re=/(\*\*(.+?)\*\*)|(\[([^\]]+)\]\((https?:[^)\s]+)\))|(`([^`]+)`)|(\*([^*\s][^*]*?)\*)/g;
  let m, last=0;
  while((m=re.exec(text))){
    push(text.slice(last,m.index));
    if(m[1]) runs.push(...inline(m[2],{...st,bold:true},size));
    else if(m[3]) runs.push(new ExternalHyperlink({link:m[5],children:[new TextRun({text:m[4],font:F,size,color:'0563C1',underline:{},...(st.bold?{bold:true}:{})})]}));
    else if(m[6]){ const c=m[7]; if(/^\[TBC/.test(c)||/^TBC/.test(c)) push(c,{italics:true,color:GREY}); else push(c); }
    else if(m[8]) runs.push(...inline(m[9],{...st,italics:true},size));
    last=m.index+m[0].length;
  }
  push(text.slice(last));
  return runs;
}
const plain=t=>t.replace(/\*\*|`/g,'').replace(/\[([^\]]+)\]\([^)]*\)/g,'$1').replace(/(^|[^*])\*([^*]+)\*/g,'$1$2');

const bd={style:BorderStyle.SINGLE,size:4,color:'BFBFBF'};
const borders={top:bd,bottom:bd,left:bd,right:bd};
const TOTAL=9360;
function mkTable(rows){
  const head=rows[0], body=rows.slice(1), n=head.length;
  const w=[...Array(n).keys()].map(c=>{
    const lens=rows.map(r=>plain(r[c]||'').length);
    const mx=Math.min(Math.max(...lens),350);
    return Math.max(8,mx)**0.7;
  });
  const sum=w.reduce((a,b)=>a+b,0);
  let widths=w.map(x=>Math.max(900,Math.round(x/sum*TOTAL)));
  let diff=TOTAL-widths.reduce((a,b)=>a+b,0);
  const big=widths.indexOf(Math.max(...widths)); widths[big]+=diff;
  const cell=(t,wd,o={})=>new TableCell({width:{size:wd,type:WidthType.DXA},borders,margins:{top:80,bottom:80,left:100,right:100},
    shading:o.fill?{type:ShadingType.CLEAR,fill:o.fill,color:'auto'}:undefined,
    children:[new Paragraph({spacing:{after:0},children:inline(t,o.st||{},18)})]});
  return new Table({width:{size:TOTAL,type:WidthType.DXA},columnWidths:widths,rows:[
    new TableRow({tableHeader:true,children:head.map((h,i)=>cell(h,widths[i],{fill:BLUE,st:{bold:true,color:'FFFFFF'}}))}),
    ...body.map((r,ri)=>new TableRow({cantSplit:true,children:head.map((_,i)=>cell(r[i]||'',widths[i],{fill:ri%2?'F2F2F2':undefined}))}))]});
}

const body=[]; const numbering=[{reference:'b',levels:[{level:0,format:LevelFormat.BULLET,text:'•',alignment:AlignmentType.LEFT,style:{paragraph:{indent:{left:720,hanging:360}}}}]}];
let listCount=0, titleDone=false, i=0;
const sp=()=>new Paragraph({spacing:{after:120},children:[]});
while(i<lines.length){
  const ln=lines[i];
  if(!ln.trim()||/^---+$/.test(ln.trim())){i++;continue;}
  let m;
  if(/^# /.test(ln)){
    const t=ln.slice(2).trim(); const parts=t.split(' — ');
    if(!titleDone){
      body.push(new Paragraph({spacing:{after:0},children:[new TextRun({text:parts[0],font:F,size:48,bold:true,color:BLUE})]}));
      body.push(new Paragraph({spacing:{after:240},children:[new TextRun({text:parts.slice(1).join(' — ')||'JMCO',font:F,size:48,bold:true,color:BLUE})]}));
      titleDone=true;
    } else body.push(new Paragraph({heading:HeadingLevel.HEADING_1,spacing:{before:300,after:120},keepNext:true,children:[new TextRun({text:t,font:F,size:28,bold:true,color:BLUE})]}));
    i++;continue;
  }
  if(/^## /.test(ln)){ body.push(new Paragraph({heading:HeadingLevel.HEADING_1,spacing:{before:300,after:120},keepNext:true,children:[new TextRun({text:ln.slice(3).trim(),font:F,size:28,bold:true,color:BLUE})]})); i++;continue;}
  if(/^### /.test(ln)){ body.push(new Paragraph({heading:HeadingLevel.HEADING_2,spacing:{before:200,after:100},keepNext:true,children:[new TextRun({text:ln.slice(4).trim(),font:F,size:22,bold:true})]})); i++;continue;}
  if(/^\|/.test(ln)){
    const rows=[]; while(i<lines.length&&/^\|/.test(lines[i])){ const l=lines[i].trim(); if(!/^\|[\s:|-]+\|?$/.test(l)){ rows.push(l.replace(/^\||\|$/g,'').split('|').map(s=>s.trim())); } i++; }
    body.push(mkTable(rows)); body.push(sp()); continue;
  }
  if((m=ln.match(/^(\d+)\. (.*)/))){
    const ref='n'+(++listCount);
    numbering.push({reference:ref,levels:[{level:0,format:LevelFormat.DECIMAL,text:'%1.',alignment:AlignmentType.LEFT,style:{paragraph:{indent:{left:720,hanging:360}}}}]});
    while(i<lines.length&&(m=lines[i].match(/^(\d+)\. (.*)/))){ body.push(new Paragraph({numbering:{reference:ref,level:0},spacing:{after:60},children:inline(m[2])})); i++; }
    continue;
  }
  if(/^- /.test(ln)){
    while(i<lines.length&&/^- /.test(lines[i])){ body.push(new Paragraph({numbering:{reference:'b',level:0},spacing:{after:60},children:inline(lines[i].slice(2))})); i++; }
    continue;
  }
  body.push(new Paragraph({spacing:{after:120,line:276},children:inline(ln)})); i++;
}

const doc=new Document({
  styles:{default:{document:{run:{font:F,size:20}}}},
  numbering:{config:numbering},
  sections:[{properties:{page:{size:{width:12240,height:15840},margin:{top:1440,right:1440,bottom:1440,left:1440}}},
    footers:{default:new Footer({children:[new Paragraph({alignment:AlignmentType.RIGHT,children:[new TextRun({children:[PageNumber.CURRENT],font:'Cambria',size:18})]})]})},
    children:body}]});
Packer.toBuffer(doc).then(b=>{fs.writeFileSync(out,b);console.log('wrote',out,b.length);});
